<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/27" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.PaymentsController" spacing="18.0" maxWidth="Infinity" maxHeight="Infinity" styleClass="workspace-content">
 <padding><Insets top="30" right="34" bottom="30" left="34"/></padding>
 <VBox spacing="4"><Label text="Tagihan &amp; Pembayaran" styleClass="page-title"/><Label text="Kelola tagihan dan catat pembayaran siswa" styleClass="page-subtitle"/></VBox>
 <HBox spacing="10"><TextField fx:id="searchField" promptText="Cari siswa, NIS, atau bulan" styleClass="search-field" HBox.hgrow="ALWAYS"/><ComboBox fx:id="filterBox" prefWidth="130"/><Button text="Buat Tagihan Tahunan" onAction="#createBills" styleClass="primary-button"/><Button text="Terima Pembayaran" onAction="#receive" styleClass="secondary-button"/><Button text="Lihat Kwitansi" onAction="#receipt" styleClass="secondary-button"/></HBox>
 <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
</VBox>
